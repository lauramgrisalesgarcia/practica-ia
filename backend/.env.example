# Copia este archivo como .env y define tus propios valores. .env nunca se versiona.
# Usa el usuario y la contraseña definidos en el .env de la raíz (POSTGRES_USER / POSTGRES_PASSWORD).
DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@127.0.0.1:5433/practica_ia
TEST_DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@127.0.0.1:5433/practica_ia_test

# Clave para firmar los JWT (mínimo 32 caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
